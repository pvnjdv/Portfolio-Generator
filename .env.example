# Environment Variables Template for Portfolio Generator
# Copy this file to .env.local and replace with your actual values

# Supabase Configuration
# Get these from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Groq AI API Key  
# Get this from: https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here

# Application URL
# For development: http://localhost:3000
# For production: https://portfolio.hackydaddy.xyz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Setup Instructions:
# 1. Copy this file: cp .env.example .env.local
# 2. Replace all placeholder values with your actual API keys
# 3. Never commit .env.local to version control